# Supabase (클라우드 프로젝트 → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (계약서 추출·내용증명 초안 — 서버 전용)
# https://console.anthropic.com/ 에서 발급. 추출 모델: claude-haiku-5-5
ANTHROPIC_API_KEY=

# 앱
# "오늘" 기준 타임존 (F2 기한·연체 계산)
APP_TIMEZONE=Asia/Seoul
